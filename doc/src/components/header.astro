---
import SidebarToggle from "@/components/sidebar-toggle";
import ThemeToggle from "@/components/theme-toggle";
import VersionSwitcher from "@/components/version-switcher.astro";
import Search from "@/components/search.astro";
import { settings } from "@/config/settings";
import { withBase, stripBase } from "@/utils/base";
import { defaultLocale, locales, t, type Locale } from "@/config/i18n";
import type { VersionAvailability } from "@/utils/version-availability";

interface Props {
  lang?: Locale;
  currentPath?: string;
  currentVersion?: string;
  currentSlug?: string;
  versionAvailability?: VersionAvailability;
}

const {
  lang,
  currentPath = "",
  currentVersion,
  currentSlug,
  versionAvailability,
} = Astro.props;
const isNonDefaultLocale = lang != null && lang !== defaultLocale;
const pathWithoutBase = stripBase(currentPath);
const pathForMatch = isNonDefaultLocale
  ? pathWithoutBase.replace(new RegExp(`^/${lang}`), "")
  : pathWithoutBase;

const activeNavPath = settings.headerNav
  .filter((item) => pathForMatch.startsWith(item.path))
  .sort((a, b) => b.path.length - a.path.length)[0]?.path;
---

<header
  class="sticky top-0 z-50 flex h-[3.5rem] items-center border-b border-muted bg-surface px-hsp-lg"
>
  <SidebarToggle client:media="(max-width: 1023px)">
    <slot name="sidebar" />
    <Fragment slot="bottomContent">
      {
        settings.colorMode && (
          <ThemeToggle
            defaultMode={settings.colorMode.defaultMode}
            client:load
          />
        )
      }
      {lang && locales.length > 1 && <LanguageSwitcher lang={lang} />}
    </Fragment>
  </SidebarToggle>

  <a
    href={withBase(isNonDefaultLocale ? `/${lang}/` : "/")}
    class="flex items-center gap-2 whitespace-nowrap text-subheading font-normal font-futura text-fg hover:underline focus:underline"
  >
    <span
      class="inline-block h-7 w-7 shrink-0"
      style={`background-color: currentColor; -webkit-mask-image: url(${withBase("/img/logo.svg")}); mask-image: url(${withBase("/img/logo.svg")}); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;`}
      aria-hidden="true"
    ></span>
    {settings.siteName}
  </a>

  <nav
    aria-label="Main"
    class="ml-hsp-xl hidden items-center gap-x-hsp-2xs whitespace-nowrap lg:flex overflow-hidden"
    data-header-nav
  >
    {
      settings.headerNav.map((item) => {
        const isActive = item.path === activeNavPath;
        const href = withBase(
          isNonDefaultLocale ? `/${lang}${item.path}` : item.path,
        );
        return (
          <a
            href={href}
            aria-current={isActive ? "page" : undefined}
            data-nav-item
            class:list={[
              "px-hsp-md py-vsp-2xs text-small font-medium font-futura transition-colors shrink-0",
              isActive
                ? "bg-fg text-bg"
                : "text-muted hover:underline focus:underline",
            ]}
          >
            {item.labelKey ? t(item.labelKey, lang) : item.label}
          </a>
        );
      })
    }

    <!-- Overflow "more" button -->
    <div class="relative shrink-0 hidden" data-nav-more>
      <button
        type="button"
        class="px-hsp-md py-vsp-2xs text-small font-medium font-futura text-muted hover:underline cursor-pointer"
        data-nav-more-toggle
        aria-expanded="false"
      >
        &middot;&middot;&middot;
      </button>
      <ul
        class="absolute right-0 top-full z-10 mt-vsp-3xs hidden min-w-[8rem] border border-muted rounded bg-surface shadow-lg whitespace-nowrap"
        data-nav-more-menu
      >
      </ul>
    </div>
  </nav>

  <div class="ml-auto flex shrink-0 items-center gap-x-hsp-md">
    {
      settings.colorTweakPanel && (
        <button
          id="color-tweak-trigger"
          type="button"
          class="flex items-center justify-center text-muted transition-colors hover:text-fg"
          aria-label="Toggle color tweak panel"
          onclick="window.dispatchEvent(new CustomEvent('toggle-color-tweak-panel'))"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="13.5" cy="6.5" r="2.5" />
            <circle cx="17.5" cy="10.5" r="2.5" />
            <circle cx="8.5" cy="7.5" r="2.5" />
            <circle cx="6.5" cy="12.5" r="2.5" />
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
          </svg>
        </button>
      )
    }
    {
      settings.aiAssistant && (
        <button
          id="ai-chat-trigger"
          type="button"
          class="flex items-center justify-center text-muted transition-colors hover:text-fg"
          aria-label="Open AI assistant"
          onclick="window.dispatchEvent(new CustomEvent('toggle-ai-chat'))"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M9.5 2.5Q10.5 11.5 18 13Q10.5 14.5 9.5 23.5Q8.5 14.5 1 13Q8.5 11.5 9.5 2.5Z" />
            <path d="M19 0.5Q19.5 4 23.5 5Q19.5 6 19 9.5Q18.5 6 14.5 5Q18.5 4 19 0.5Z" />
          </svg>
        </button>
      )
    }
    {
      settings.versions && (
        <div class="hidden lg:block">
          <VersionSwitcher
            currentVersion={currentVersion}
            currentSlug={currentSlug}
            lang={lang}
            availability={versionAvailability}
            idSuffix="header"
          />
        </div>
      )
    }
    <Search />
    <div class="hidden lg:flex items-center gap-x-hsp-md">
      {
        settings.colorMode && (
          <ThemeToggle
            defaultMode={settings.colorMode.defaultMode}
            client:load
          />
        )
      }
      {lang && locales.length > 1 && <LanguageSwitcher lang={lang} />}
    </div>
  </div>
</header>

<script>
  function initNavOverflow() {
    const nav = document.querySelector<HTMLElement>("[data-header-nav]");
    const moreBtn = document.querySelector<HTMLElement>("[data-nav-more]");
    const moreMenu = document.querySelector<HTMLElement>("[data-nav-more-menu]");
    const moreToggle = document.querySelector<HTMLButtonElement>("[data-nav-more-toggle]");
    if (!nav || !moreBtn || !moreMenu || !moreToggle) return;

    const items = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-nav-item]"));
    if (items.length === 0) return;

    function update() {
      // Reset: show all items, hide more button
      items.forEach((el) => (el.style.display = ""));
      moreBtn!.classList.add("hidden");
      moreMenu!.innerHTML = "";

      // Measure: does the nav overflow?
      const navRight = nav!.getBoundingClientRect().right;
      const overflowed: HTMLAnchorElement[] = [];

      for (let i = items.length - 1; i >= 0; i--) {
        const item = items[i];
        const itemRight = item.getBoundingClientRect().right;
        if (itemRight > navRight - 40) {
          // 40px buffer for the "..." button
          overflowed.unshift(item);
        } else {
          break;
        }
      }

      if (overflowed.length === 0) return;

      // Hide overflowed items and show "..." button
      overflowed.forEach((el) => (el.style.display = "none"));
      moreBtn!.classList.remove("hidden");

      // Populate the dropdown
      overflowed.forEach((el) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = el.href;
        a.textContent = el.textContent?.trim() || "";
        a.className =
          "block px-hsp-md py-vsp-3xs text-small hover:bg-accent/10 text-fg";
        if (el.getAttribute("aria-current") === "page") {
          a.className += " font-bold text-accent";
        }
        li.appendChild(a);
        moreMenu!.appendChild(li);
      });
    }

    // Toggle dropdown
    moreToggle.addEventListener("click", () => {
      const isOpen = !moreMenu!.classList.contains("hidden");
      moreMenu!.classList.toggle("hidden", isOpen);
      moreToggle!.setAttribute("aria-expanded", String(!isOpen));
    });

    // Close on outside click
    document.addEventListener("click", (e) => {
      if (!moreBtn!.contains(e.target as Node)) {
        moreMenu!.classList.add("hidden");
        moreToggle!.setAttribute("aria-expanded", "false");
      }
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !moreMenu!.classList.contains("hidden")) {
        moreMenu!.classList.add("hidden");
        moreToggle!.setAttribute("aria-expanded", "false");
        moreToggle!.focus();
      }
    });

    // Run on load and resize
    update();
    window.addEventListener("resize", update);
  }

  initNavOverflow();
  document.addEventListener("astro:after-swap", initNavOverflow);
</script>

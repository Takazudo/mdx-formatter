{
  "name": "@takazudo/mdx-formatter",
  "version": "0.1.1",
  "description": "AST-based markdown and MDX formatter with Japanese text support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mdx-formatter": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "format-stdin.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "format": "npx tsx src/cli.ts --write \"**/*.{md,mdx}\"",
    "format:check": "npx tsx src/cli.ts --check \"**/*.{md,mdx}\"",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check": "prettier --check . && eslint .",
    "check:fix": "prettier --write . && eslint --fix .",
    "prepare": "husky",
    "prepublishOnly": "tsc && vitest run"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    ".claude/**/*.md": [
      "prettier --write"
    ],
    "doc/docs/**/*.{md,mdx}": [
      "npx tsx src/cli.ts --write"
    ]
  },
  "keywords": [
    "markdown",
    "mdx",
    "formatter",
    "remark",
    "unified",
    "japanese",
    "docusaurus",
    "jsx",
    "ast",
    "gfm"
  ],
  "author": "Takazudo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/mdx-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/mdx-formatter/issues"
  },
  "homepage": "https://takazudomodular.com/pj/mdx-formatter/",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "glob": "^13.0.1",
    "js-yaml": "^4.1.1",
    "prettier": "^3.8.0",
    "remark": "^15.0.1",
    "remark-directive": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.2.1",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vfile": "^6.0.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
